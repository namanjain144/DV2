{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth map: unintentional drowning rate per 100,000 people by state and territory, 2024/25.",
  "width": "container",
  "height": 420,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "url": "data/aus_drowning_by_state_2024_25.csv"
            },
            "key": "state",
            "fields": [
              "state_code",
              "deaths_2024_25",
              "rate_2024_25_per_100k",
              "rate_10yr_avg_per_100k",
              "change_vs_10yr_avg_pct"
            ]
          }
        }
      ],
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      },
      "encoding": {
        "color": {
          "field": "rate_2024_25_per_100k",
          "type": "quantitative",
          "title": "Rate per 100,000",
          "scale": {
            "range": [
              "#d6eaf1",
              "#123b57"
            ],
            "domain": [
              0,
              1.8
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "direction": "horizontal",
            "gradientLength": 160
          }
        },
        "strokeWidth": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 3
          },
          "value": 1.2
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "title": "State"
          },
          {
            "field": "deaths_2024_25",
            "title": "Drowning deaths 2024/25"
          },
          {
            "field": "rate_2024_25_per_100k",
            "title": "Rate per 100,000",
            "format": ".2f"
          },
          {
            "field": "rate_10yr_avg_per_100k",
            "title": "10-year average rate",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "code": "WA",
            "lon": 121.5,
            "lat": -26.0
          },
          {
            "code": "NT",
            "lon": 133.4,
            "lat": -19.5
          },
          {
            "code": "SA",
            "lon": 135.5,
            "lat": -30.0
          },
          {
            "code": "QLD",
            "lon": 144.5,
            "lat": -23.0
          },
          {
            "code": "NSW",
            "lon": 146.5,
            "lat": -32.3
          },
          {
            "code": "VIC",
            "lon": 144.0,
            "lat": -37.0
          },
          {
            "code": "TAS",
            "lon": 151.2,
            "lat": -42.6
          }
        ]
      },
      "transform": [
        {
          "lookup": "code",
          "from": {
            "data": {
              "url": "data/aus_drowning_by_state_2024_25.csv"
            },
            "key": "state_code",
            "fields": [
              "rate_2024_25_per_100k"
            ]
          }
        },
        {
          "calculate": "datum.code + '  ' + format(datum.rate_2024_25_per_100k, '.2f')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "condition": {
            "test": "datum.rate_2024_25_per_100k > 1.2 && datum.code != 'TAS'",
            "value": "#ffffff"
          },
          "value": "#123b57"
        }
      }
    }
  ]
}