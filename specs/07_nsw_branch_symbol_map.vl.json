{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map: NSW coastal drowning deaths (circle size) and average rate (circle colour) by Surf Life Saving NSW branch, 2015 to 2025. Circle positions are approximate, placed at a reference town in each branch.",
  "width": "container",
  "height": 520,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -29,
      -37
    ],
    "rotate": [
      -148,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/nsw_outline.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eef5f8",
        "stroke": "#8a99a6",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/nsw_branch_locations.csv"
      },
      "mark": {
        "type": "circle",
        "stroke": "#ffffff",
        "strokeWidth": 1,
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "deaths_2015_25",
          "type": "quantitative",
          "title": "Deaths, 2015 to 2025",
          "scale": {
            "range": [
              60,
              1400
            ]
          },
          "legend": {
            "orient": "top-left",
            "values": [
              20,
              50,
              100
            ]
          }
        },
        "color": {
          "field": "average_rate_per_100k",
          "type": "quantitative",
          "title": "Rate per 100,000",
          "scale": {
            "range": [
              "#f6d77a",
              "#d7262e"
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "direction": "horizontal",
            "gradientLength": 140
          }
        },
        "tooltip": [
          {
            "field": "branch",
            "title": "Branch"
          },
          {
            "field": "deaths_2015_25",
            "title": "Deaths 2015 to 2025"
          },
          {
            "field": "average_rate_per_100k",
            "title": "Average rate per 100,000",
            "format": ".2f"
          },
          {
            "field": "reference_town",
            "title": "Circle placed at"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/nsw_branch_locations.csv"
      },
      "transform": [
        {
          "filter": "indexof(['Sydney','Northern Beaches','Central Coast'], datum.branch) < 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 18,
        "fontSize": 11,
        "color": "#1d2b36"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "branch"
        }
      }
    },
    {
      "data": {
        "url": "data/nsw_branch_locations.csv"
      },
      "transform": [
        {
          "filter": "datum.branch == 'Central Coast'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 18,
        "fontSize": 11,
        "color": "#1d2b36",
        "dy": -10
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "branch"
        }
      }
    },
    {
      "data": {
        "url": "data/nsw_branch_locations.csv"
      },
      "transform": [
        {
          "filter": "datum.branch == 'Northern Beaches'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 18,
        "fontSize": 11,
        "color": "#1d2b36",
        "dy": 2
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "branch"
        }
      }
    },
    {
      "data": {
        "url": "data/nsw_branch_locations.csv"
      },
      "transform": [
        {
          "filter": "datum.branch == 'Sydney'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 18,
        "fontSize": 11,
        "color": "#1d2b36",
        "dy": 13
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "branch"
        }
      }
    }
  ],
  "padding": {
    "left": 5,
    "top": 5,
    "bottom": 5,
    "right": 120
  }
}