{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bar chart: NSW surf rescues by craft or method, 2024/25.",
  "width": "container",
  "height": 280,
  "data": {
    "url": "data/nsw_rescues_2024_25.csv"
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "rescues",
          "as": "total"
        }
      ]
    },
    {
      "calculate": "datum.rescues / datum.total",
      "as": "share"
    }
  ],
  "encoding": {
    "y": {
      "field": "craft_or_method",
      "type": "nominal",
      "sort": [
        "Rescue board",
        "Rescue tube",
        "IRB",
        "No gear",
        "RWC",
        "Helicopter",
        "Other",
        "Surfboard",
        "JRB/ORB/RIB"
      ],
      "title": null,
      "axis": {
        "ticks": false,
        "domain": false
      }
    },
    "x": {
      "field": "rescues",
      "type": "quantitative",
      "title": "Rescues in 2024/25"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 2
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.craft_or_method == 'Rescue board'",
            "value": "#d7262e"
          },
          "value": "#5ea9c4"
        },
        "tooltip": [
          {
            "field": "craft_or_method",
            "title": "Craft or method"
          },
          {
            "field": "rescues",
            "title": "Rescues",
            "format": ","
          },
          {
            "field": "share",
            "title": "Share",
            "format": ".0%"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 11
      },
      "encoding": {
        "text": {
          "field": "rescues",
          "format": ","
        }
      }
    }
  ]
}